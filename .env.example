# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sportsbot:your_password_here@localhost:5432/sportsbot

# ─── Encryption ─────────────────────────────────────────────
# 32-byte hex key for AES-256-GCM. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=your_64_char_hex_key_here

# ─── Google Gemini ──────────────────────────────────────────
GOOGLE_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.0-flash

# ─── Telegram Notifications ────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ─── Booking Config ────────────────────────────────────────
# Retry offsets in seconds around the target booking time
BOOKING_RETRY_OFFSETS=[0, 5, 15]

# Directory to save failure screenshots
SCREENSHOT_DIR=./screenshots

# ─── PostgreSQL (for Docker Compose) ───────────────────────
POSTGRES_PASSWORD=your_postgres_password_here
